    },
    "133": {
      "source_en": "\t\t\" ^FF0000Storehouse^000000 must be destroyed.\",",
      "translation_tr": "\t\t\" ^FF0000Deposu^000000 yok edilmelidir.\","
    },
    "134": {
      "source_en": "\t\t\" By occupying the Central Base(Neutral Camp)\",",
      "translation_tr": "\t\t\" Merkez Ussu (Tarafsiz Kamp) ele gecirerek\","
    },
    "135": {
      "source_en": "\t\t\" you will be able to respawn in that area instead of your base camp.\",",
      "translation_tr": "\t\t\" kendi ana kampiniz yerine bu bolgede yeniden dogabilirsiniz.\","
    },
    "136": {
      "source_en": "\t\t\" Summoning a guardian is a good strategy.\",",
      "translation_tr": "\t\t\" Bir muhafiz cagirmak iyi bir stratejidir.\","
    },
    "137": {
      "source_en": "\t\t\" However, do not forget that you still have to \",",
      "translation_tr": "\t\t\" Ancak yine de\","
    },
    "138": {
      "source_en": "\t\t\" defend your Storehouse in your base camp.\",",
      "translation_tr": "\t\t\" ana kampinizdaki Depoyu savunmaniz gerektigini unutmayin.\","
