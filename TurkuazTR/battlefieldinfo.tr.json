    },
    "116": {
      "source_en": "\t\t\" Camp A - Guillaume team.\",",
      "translation_tr": "\t\t\" Kamp A - Guillaume takimi.\","
    },
    "117": {
      "source_en": "\t\t\" Camp B - Croix team.\",",
      "translation_tr": "\t\t\" Kamp B - Croix takimi.\","
    },
    "119": {
      "source_en": "\t\t\" For more information about each sides\",",
      "translation_tr": "\t\t\" Taraflar hakkinda daha fazla bilgi icin\","
