    "67": {
      "source_en": "\t\t\"^0000FF3. Battlefield Teleportation is ^FF0000pending^0000FF when^000000\",",
      "translation_tr": "\t\t\"^0000FF3. Savas Alani isinlanmasi su durumda ^FF0000beklemededir^0000FF:^000000\","
    },
    "68": {
      "source_en": "\t\t\" - The teleportation is currently not possible.\",",
      "translation_tr": "\t\t\" - Isinlanma su anda mumkun degilse.\","
    },
    "69": {
      "source_en": "\t\t\" - Other participants are not ready yet.\",",
      "translation_tr": "\t\t\" - Diger katilimcilar henuz hazir degilse.\","
    },
    "70": {
      "source_en": "\t\t\" If you just wait long enough, you will be\",",
      "translation_tr": "\t\t\" Bir sure beklerseniz\","
    },
    "71": {
      "source_en": "\t\t\" teleported to the battlfield automatically.\",",
      "translation_tr": "\t\t\" savas alanina otomatik olarak isinlanirsiniz.\","
    },
    "74": {
      "source_en": "\t\t\"[Rewards for Playing]\",",
      "translation_tr": "\t\t\"[Katilim Odulleri]\","
    },
    "75": {
      "source_en": "\t\t\"^0000FF1. Points^000000\",",
      "translation_tr": "\t\t\"^0000FF1. Puanlar^000000\","
    },
    "76": {
      "source_en": "\t\t\" If the full length Battlefield is done\",",
      "translation_tr": "\t\t\" Savas Alani maci tamamlandiginda\","
    },
    "77": {
      "source_en": "\t\t\" Depending on the winner ^FF0000a certain amount of points^000000\",",
      "translation_tr": "\t\t\" kazanan tarafa gore ^FF0000belirli miktarda puan^000000\","
    },
    "78": {
      "source_en": "\t\t\" can be obtained.\",",
      "translation_tr": "\t\t\" kazanilabilir.\","
    },
    "79": {
      "source_en": "\t\t\" You can obtain various items\",",
      "translation_tr": "\t\t\" Biriktirdiginiz puanlarla\","
    },
    "80": {
      "source_en": "\t\t\" by using the points accumulated.\",",
      "translation_tr": "\t\t\" cesitli esyalar alabilirsiniz.\","
    },
    "82": {
      "source_en": "\t\t\"^0000FF2. Points/Badges Exchanging^000000\",",
      "translation_tr": "\t\t\"^0000FF2. Puan/Rozet Takasi^000000\","
    },
    "83": {
      "source_en": "\t\t\" Click the Maroll the Recruiter\",",
      "translation_tr": "\t\t\" Kayit Gorevlisi Maroll'a tiklayarak\","
    },
    "84": {
      "source_en": "\t\t\" to warp to the Battlefield area.\",",
      "translation_tr": "\t\t\" Savas Alani bolgesine isinlanin.\","
    },
    "85": {
      "source_en": "\t\t\" From there you can find the\",",
      "translation_tr": "\t\t\" Orada cesitli esyalarla takas yapan\","
    },
    "86": {
      "source_en": "\t\t\" NPCs that exchanges for various items.\",",
      "translation_tr": "\t\t\" NPC'leri bulabilirsiniz.\","
    },
    "88": {
      "source_en": "\t\t\"^0000FF3. Situations for Point Reward Changes^000000\",",
      "translation_tr": "\t\t\"^0000FF3. Puan Odulunun Degisebildigi Durumlar^000000\","
    },
    "89": {
      "source_en": "\t\t\" - Some participants have deserted the match.\",",
      "translation_tr": "\t\t\" - Bazi katilimcilar maci terk etmisse.\","
    },
    "90": {
      "source_en": "\t\t\" - Deserters ^FF000000won't recieve^000000 any reward.\",",
      "translation_tr": "\t\t\" - Maci terk edenler ^FF000000odul alamaz^000000.\","
    },
    "91": {
      "source_en": "\t\t\" - The reward amount may change dynamically\",",
      "translation_tr": "\t\t\" - Odul miktari dinamik olarak degisebilir\","
    },
    "92": {
      "source_en": "\t\t\"   depending on the number of participants\",",
      "translation_tr": "\t\t\"   katilimci sayisina bagli olarak\","
    },
    "93": {
      "source_en": "\t\t\"   within a certain period of time after the\",",
      "translation_tr": "\t\t\"   mac basladiktan sonraki belirli bir\","
    },
    "94": {
      "source_en": "\t\t\"   start of the match.\",",
      "translation_tr": "\t\t\"   sure icinde.\","
    },
    "95": {
      "source_en": "\t\t\" - The reward amount is calculated\",",
      "translation_tr": "\t\t\" - Odul miktari\","
    },
    "96": {
      "source_en": "\t\t\"   during the match.\"",
      "translation_tr": "\t\t\"   mac sirasinda hesaplanir.\""
    },
    "99": {
      "source_en": "\t\t\"1. ^0000FFName^000000: Flavius Battlefield\",",
      "translation_tr": "\t\t\"1. ^0000FFAd^000000: Flavius Savas Alani\","
    },
    "101": {
      "source_en": "\t\t\"2. ^0000FFMatch Type^000000: ^FF000010^000000 vs ^FF000010^000000\",",
      "translation_tr": "\t\t\"2. ^0000FFMac Turu^000000: ^FF000010^000000 vs ^FF000010^000000\","
    },
    "103": {
      "source_en": "\t\t\"3. ^0000FFRequired Level^000000: ^FF0000Level 80 and up^000000\",",
      "translation_tr": "\t\t\"3. ^0000FFGerekli Seviye^000000: ^FF0000Seviye 80 ve uzeri^000000\","
    },
    "105": {
      "source_en": "\t\t\"4. ^0000FFDescription^000000\",",
      "translation_tr": "\t\t\"4. ^0000FFAciklama^000000\","
    },
    "106": {
      "source_en": "\t\t\" To win the battle, the opposing team's\",",
      "translation_tr": "\t\t\" Savasi kazanmak icin rakip takimin\","
    },
    "107": {
      "source_en": "\t\t\" ^FF0000Crystal^000000 must be destroyed.\",",
      "translation_tr": "\t\t\" ^FF0000Kristali^000000 yok edilmelidir.\","
    },
    "108": {
      "source_en": "\t\t\" However, keep in mind that near the crystal\",",
      "translation_tr": "\t\t\" Ancak kristalin yakininda\","
    },
    "109": {
      "source_en": "\t\t\" there are powerful guardians defending it.\",",
      "translation_tr": "\t\t\" onu koruyan guclu muhafizlar oldugunu unutmayin.\","
    },
    "110": {
      "source_en": "\t\t\" 1 Point will be given to the team\",",
      "translation_tr": "\t\t\" Kristali basariyla yok eden takima\","
    },
    "111": {
      "source_en": "\t\t\" for successfully destroying the crystal.\",",
      "translation_tr": "\t\t\" 1 puan verilir.\","
    },
    "112": {
      "source_en": "\t\t\" Your team wins when you\",",
      "translation_tr": "\t\t\" Takiminiz\","
    },
    "113": {
      "source_en": "\t\t\" obtain 2 points.\",",
      "translation_tr": "\t\t\" 2 puana ulastiginda kazanir.\","
    },
    "115": {
      "source_en": "\t\t\"5. ^0000FFCamp Information^000000\",",
