    "NV_BASIC": {
      "name_original": "Basic Skill",
      "lines_tr": [
        "Maks. Seviye: 9",
        "Beceri Turu: ^6666CCPasif^000000",
        "Aciklama: ^777777Temel Arayuz Becerilerini kullanmayi",
        "saglar.^000000",
        "[Sv 1]: Takasi Acar",
        "^777777Diger ^00A100Oyuncular^777777 ile ^990099Item^777777 ve ^990099Zeny^777777",
        "takasi yapabilirsin.",
        "^990000Baslatmak icin oyuncuya sag tikla.^000000",
        "[Sv 2]: Ifadeleri Acar",
        "^777777Alt+(0~9) ve Ctrl+(1,-,=.)",
        "Alt+L ile ^990099Ifade Penceresi^777777 acilir.^000000",
        "[Sv 3]: Oturmayi Acar",
        "^777777HP ve SP yenilenme hizini iki katina cikarir.",
        "^990000Insert tusuna bas veya /sit yaz.^000000",
        "[Sv 4]: Sohbet Odasi Acmayi Acar",
        "^777777Alt+C ile Sohbet Odasi acilir.^000000",
        "[Sv 5]: Party'ye Katilmayi Acar",
        "^777777Karakter bir party'ye katilabilir.^000000",
        "[Sv 6]: Kafra Storage Kullanimini Acar",
        "^777777^0000FFKafra Staff^777777 ile konusarak ^990099Storage^777777 acabilirsin.^000000",
        "[Sv 7]: Party Kurmayi Acar",
        "^777777Bir party olusturur.",
        "^990099/organize \"Party Adi\"^777777 yaz.",
        "Party ayarlarini Party Penceresi'nden (Alt+Z) yap.^000000",
        "[Sv 9]: Ilk Job Class Degisimini Acar",
        "^777777Karakterin ^00A100Novice^777777 sinifindan ^00A100First^777777 veya ^00A100Expanded^777777",
        "siniflardan birine gecmesini saglar.^000000"
