      "replacement": "Tum elementlerle Buyu Hasarini %\\1 artirir."
    },
    {
      "id": "fixed_cast",
      "type": "regex",
      "pattern": "Decreases Fixed Casting Time by ([0-9.]+) seconds\\.",
      "replacement": "Sabit kullanma suresini \\1 saniye azaltir."
    },
    {
      "id": "variable_cast_additional",
      "type": "regex",
      "pattern": "Decreases Variable Casting Time by additional (\\d+)%\\.",
      "replacement": "Degisken kullanma suresini ek %\\1 azaltir."
    },
    {
      "id": "demi_human_damage_taken",
      "type": "regex",
      "pattern": "Decreases Damage taken from (\\^FF0000Demi-Human\\^000000) race by (\\d+)%\\.",
      "replacement": "\\1 irkindan alinan hasari %\\2 azaltir."
    },
    {
      "id": "movement_speed",
      "type": "literal",
      "source": "Increases movement speed.",
      "translation": "Hareket hizini artirir."
    },
    {
      "id": "skill_cast_uninterruptible",
      "type": "literal",
      "source": "Skill casting cannot be interrupted.",
      "translation": "Beceri kullanimi kesintiye ugratilamaz."
    },
    {
      "id": "vip_status_active",
      "type": "literal",
      "source": "When ^990099VIP^000000 status active:",
      "translation": "^990099VIP^000000 durumu aktifken:"
    },
    {
      "id": "pet_incubator_hatch",
      "type": "literal",
      "source": "Can be hatched by using a ^0033CCPet Incubator^000000.",
      "translation": "^0033CCPet Incubator^000000 kullanilarak yumurtadan cikarilabilir."
    },
    {
      "id": "for_each_refine_entire_set",
      "type": "literal",
      "source": "^0000FFFor each Refine Level^000000 of ^0000FFentire set^000000:",
      "translation": "^0000FFTum setin her Gelistirme Seviyesi icin^000000:"
    },
    {
      "id": "total_refine_entire_set_at_least",
      "type": "regex",
      "pattern": "\\^0000FFTotal Refine Level of entire set\\^000000(?: is)? at least \\^0000FF\\+(\\d+)\\^000000:",
      "replacement": "^0000FFTum setin toplam Gelistirme Seviyesi^000000 en az ^0000FF+\\1^000000 ise:"
    },
    {
      "id": "base_level_at_least",
      "type": "regex",
      "pattern": "\\^CC6600Base Level\\^000000 at least \\^FF0000(\\d+)\\^000000:",
      "replacement": "^CC6600Temel Seviye^000000 en az ^FF0000\\1^000000 ise:"
    },
    {
      "id": "for_each_n_base_level",
      "type": "regex",
      "pattern": "For each \\^0000FF(\\d+) \\^CC6600Base Level\\^000000:",
      "replacement": "Her ^0000FF\\1 ^CC6600Temel Seviye^000000 icin:"
    },
    {
      "id": "not_tradeable_accounts",
      "type": "literal",
      "source": "^ff0000This item cannot be traded with other accounts.^000000",
      "translation": "^ff0000Bu esya diger hesaplarla takas edilemez.^000000"
    },
    {
      "id": "npc_storage_only",
      "type": "literal",
      "source": "^FF0000This item can only be sold to NPCs and moved to storage.^000000",
      "translation": "^FF0000Bu esya yalnizca NPC'lere satilabilir ve depoya tasinabilir.^000000"
    },
    {
      "id": "shadow_armor_description",
      "type": "literal",
      "source": "A suit of armor worn on top of normal armor for additional defense. Needs a complete set to have bonus effect.",
      "translation": "Ek savunma icin normal zirhin ustune giyilen bir zirh. Bonus etkisi icin setin tamamlanmasi gerekir."
    },
    {
      "id": "shadow_shoes_description",
      "type": "literal",
      "source": "A pair of shoes worn on top of normal shoes for additional defense. Needs a complete set to have bonus effect.",
      "translation": "Ek savunma icin normal ayakkabilarin ustune giyilen ayakkabilar. Bonus etkisi icin setin tamamlanmasi gerekir."
    },
    {
      "id": "shadow_gloves_description",
      "type": "literal",
      "source": "A pair of gloves that can draw the wearer's potential ability.",
      "translation": "Kullananin potansiyel yeteneklerini ortaya cikaran bir cift eldiven."
    },
    {
      "id": "shadow_earring_description",
      "type": "literal",
      "source": "A sacred earring which is believed to protect its wearer. It also draws the wearer's potential abilities.",
      "translation": "Kullanan kisiyi koruduguna inanilan kutsal bir kupe. Ayrica potansiyel yeteneklerini ortaya cikarir."
    },
    {
      "id": "shadow_necklace_description",
      "type": "literal",
      "source": "A sacred necklace which is believed to protect its wearer. It also draws the wearer's potential abilities.",
      "translation": "Kullanan kisiyi koruduguna inanilan kutsal bir kolye. Ayrica potansiyel yeteneklerini ortaya cikarir."
    },
    {
      "id": "shadow_shield_description",
      "type": "literal",
      "source": "A small shield worn on the arm for additional defense. Needs a complete set to have bonus effect.",
      "translation": "Ek savunma icin kola takilan kucuk bir kalkan. Bonus etkisi icin setin tamamlanmasi gerekir."
    },
    {
      "id": "sealed_power_description",
      "type": "literal",
      "source": "An engraved item with its power sealed inside.",
      "translation": "Gucu icine muhurlenmis islemeli bir esya."
    },
    {
      "id": "sealed_power_remains",
      "type": "literal",
      "source": "While no longer usable, the item's power remains intact.",
      "translation": "Artik kullanilamasa da esyanin gucu bozulmadan kalir."
