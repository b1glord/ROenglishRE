{
  "_file_header": {
    "path": "/ROenglishRE/TurkuazTR/config/iteminfo-rules.json",
    "purpose": "itemInfo.lua aciklama alanlarinda tekrar eden metadata ve sistem cumlelerini byte-safe ASCII Turkceye donusturen kurallari tanimlar",
    "module": "Translation Config - JSON",
    "version": "1.0.0",
    "description": "Item adlarini canonical tutar; yalniz identified/unidentified description bloklarinda metadata ve ortak sistem metinlerini cevirir",
    "dependency_layer": "Tool"
  },
  "source_path": "Translation/Renewal/SystemEN/LuaFiles514/itemInfo.lua",
  "profile_field": "item_info",
  "target_fields": [
    "unidentifiedDescriptionName",
    "identifiedDescriptionName"
  ],
  "modes": {
    "original": "Kaynak byte'larini degistirmeden kullanir.",
    "tr_metadata": "Aciklama bloklarinda Turkce metadata kurallarini uygular."
  },
  "rules": [
