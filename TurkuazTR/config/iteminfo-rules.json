      "id": "refine_level_value",
      "type": "regex",
      "pattern": "\\^0000FFRefine Level \\+(\\d+)\\^000000:",
      "replacement": "^0000FFGelistirme Seviyesi +\\1^000000:"
    },
    {
      "id": "each_refine_level",
      "type": "regex",
      "pattern": "\\^0000FFFor each Refine Level\\^000000:",
      "replacement": "^0000FFHer Gelistirme Seviyesi icin^000000:"
    },
    {
      "id": "each_n_refine_levels",
      "type": "regex",
      "pattern": "\\^0000FFFor each (\\d+) Refine Levels\\^000000:",
      "replacement": "^0000FFHer \\1 Gelistirme Seviyesi icin^000000:"
    },
    {
      "id": "base_level",
      "type": "regex",
      "pattern": "Base Level (\\d+)",
      "replacement": "Temel Seviye \\1"
    },
    {
      "id": "variable_cast",
      "type": "regex",
      "pattern": "Decreases Variable Casting Time by (\\d+)%\\.",
