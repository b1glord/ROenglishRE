  "_file_header": {
    "path": "/ROenglishRE/TurkuazTR/config/iteminfo-rules.json",
    "purpose": "itemInfo.lua aciklama alanlarinda tekrar eden metadata ve sistem cumlelerini byte-safe ASCII Turkceye donusturen kurallari tanimlar",
    "module": "Translation Config - JSON",
    "version": "1.3.0",
    "description": "Item adlarini canonical tutar; description bloklarinda metadata, sistem kosullari, element/sure degerleri, ortak hasar kaliplari ve tekrar eden ekipman metinlerini byte-safe cevirir",
    "dependency_layer": "Tool"
  },
  "source_path": "Translation/Renewal/SystemEN/LuaFiles514/itemInfo.lua",
